PORT=5000
MONGO_URI=mongodb://localhost:27017/hrk-jewellery
JWT_SECRET=replace_with_output_of__node_-e_"console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS, comma-separated, no trailing slash
FRONTEND_URL=https://your-site.vercel.app

# Cloudinary — REQUIRED in production (Render's disk is wiped on every deploy)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin account — synced into the DB on every server start
ADMIN_EMAIL=admin@hrk.com
ADMIN_PASSWORD=Admin@123
